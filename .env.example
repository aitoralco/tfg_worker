# Environment variables for filesystem (MINIO/S3) configuration
FILESYSTEM_URL=http://localhost:9000
FILESYSTEM_ID_KEY=admin
FILESYSTEM_ACCESS_KEY=12345678
FORCE_PATH_STYLE=true
REGION_NAME=us-east-1
BUCKET_NAME=videos-bucket

# Trained models (not included in the repo, see README)
DW_MODEL_PATH=app/ai/trained_models/detect_whales/best.pt
DEM_MODEL_PATH=app/ai/trained_models/detect_marks/best.pt
CW_MODEL_PATH=app/ai/trained_models/classify_whales/best.pt
