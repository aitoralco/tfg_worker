# Environment variables for postgres database
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cetaceans

# Environment variables for Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
